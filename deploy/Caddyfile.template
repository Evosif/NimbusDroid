{
	admin off
}

@PUBLIC_HOST@ {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:@API_PORT@
	}

	handle {
		reverse_proxy 127.0.0.1:@WEB_PORT@
	}
}

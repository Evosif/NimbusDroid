[Unit]
Description=Droid Cloud network helper (per-device VPN routing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DROID_CLOUD_VPN_DIR=@VPN_DIR@
Environment=DROID_CLOUD_NETD_GROUP=@SERVICE_USER@
ExecStart=@PYTHON@ -u @INSTALL_DIR@/controller/netd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Public hostname served by Caddy. Do not include a scheme or path.
DROID_CLOUD_PUBLIC_HOST=android.example.com

# Identity used by the web UI in its documented SSH command.
DROID_CLOUD_SSH_USER=ubuntu

# Service-owned runtime locations.
DROID_CLOUD_HOME=/var/lib/droid-cloud
DROID_CLOUD_SDK_ROOT=/opt/android-sdk
DROID_CLOUD_AVD_HOME=/var/lib/droid-cloud/.android/avd
DROID_CLOUD_STATE_DIR=/var/lib/droid-cloud/state
DROID_CLOUD_CACHE_DIR=/var/lib/droid-cloud/cache

# Static application and local listeners.
DROID_CLOUD_WEB_ROOT=/opt/droid-cloud/web
DROID_CLOUD_WEB_BIND=127.0.0.1:8080
DROID_CLOUD_API_HOST=127.0.0.1
DROID_CLOUD_API_PORT=8081

# websockify accepts browser WebSocket connections only from this origin.
DROID_CLOUD_ALLOWED_ORIGINS=https://android.example.com
